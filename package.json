{
  "name": "save-slot-v1",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @save-slot/web dev",
    "dev:api": "pnpm --filter @save-slot/api dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "vitest run packages",
    "lint": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json .prettierrc",
    "format": "prettier --write apps packages package.json pnpm-workspace.yaml tsconfig.base.json"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
